    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SdIOS</AssemblyName>
    <RootNamespace>SdIOS</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ManagedDir Condition="'$(ManagedDir)' == ''">C:\Stranded Deep\Stranded_Deep_Data\Managed</ManagedDir>
